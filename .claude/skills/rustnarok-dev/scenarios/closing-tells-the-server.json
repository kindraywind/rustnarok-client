{
  "about": "Closing a window the server keeps open for us tells it, whichever way it's closed. A mail being written, shut with Esc, sends CZ_REQ_CANCEL_WRITE_MAIL 0x0a03 (rathena won't let the player walk while one is being written), and a walk after it goes. F11 (all windows) on the open storage sends CZ_CLOSE_STORE 0x0193, and the storage closes on the answer. The game menu's title close does what Return does.",
  "account": "",
  "slot": 0,
  "steps": [
    {"say": "@warp prontera 156 180"},
    {"settle": 1500},
    {"click_on": {"button": "menu"}},
    {"wait": 300},
    {"click_on": {"menu_item": "mail"}},
    {"wait_for": {"sent": "0x0ac0", "ms": 2000}},
    {"wait": 800},
    {"expect": {"windows_open": ["Mailbox"]}},
    {"click_on": {"button": "mail_write"}},
    {"wait_for": {"packet": "0x0a12", "ms": 3000}},
    {"wait": 300},
    {"expect": {"windows_open": ["MailWrite", "Mailbox"]}},
    {"move": [1000, 750]},
    {"shot": "mail-write-open"},
    {"key": "Escape"},
    {"wait_for": {"sent": "0x0a03", "ms": 1000}},
    {"expect": {"windows_closed": ["MailWrite"]}},
    {"key": "Escape"},
    {"wait": 300},
    {"expect": {"windows_closed": ["Mailbox"]}},
    {"click_on": {"cell": [156, 175]}},
    {"wait_for": {"packet": "0x0087", "ms": 3000}},
    {"wait": 1500},
    {"say": "@storage"},
    {"wait_for": {"packet": "0x0b08", "ms": 8000}},
    {"wait": 500},
    {"expect": {"windows_open": ["Storage"]}},
    {"key": "F11"},
    {"wait_for": {"sent": "0x0193", "ms": 1000}},
    {"wait_for": {"event": "StorageClosed", "ms": 3000}},
    {"expect": {"windows_closed": ["Storage"]}},
    {"key": "Escape"},
    {"wait": 300},
    {"expect": {"windows_open": ["GameMenu"]}},
    {"click_on": {"button": "menu_close"}},
    {"wait": 300},
    {"expect": {"windows_closed": ["GameMenu"]}}
  ]
}
