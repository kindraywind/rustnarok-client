{
  "about": "A navigation's route on the world map. With none running, the world map shows the player's field with an outline and a face on it and no route. A navigation to another town puts a box on each field and town of its route, a strip from one to the next, the end mark on the target's, and the picked place's picture over it; the route's maps are the ones the world shows, in order. Cancelling the navigation takes the route off.",
  "account": "",
  "slot": 0,
  "steps": [
    {"say": "@warp prt_fild08 190 340"},
    {"settle": 1500},
    {"click_on": {"button": "minimap_viewon"}},
    {"wait": 600},
    {"expect": {"windows_open": ["WorldMap"], "state": {"world_map.route": []}}},
    {"move": [40, 740]},
    {"shot": "worldmap-no-route", "crop": [560, 380, 300, 260], "threshold": 2},
    {"key": "Escape"},
    {"wait": 300},
    {"say": "/navi geffen 120/60"},
    {"wait": 600},
    {"expect": {"chat": "Navigation >: A route was found", "state": {"navigation.map": "geffen"}}},
    {"click_on": {"button": "minimap_viewon"}},
    {"wait": 600},
    {"expect": {"windows_open": ["WorldMap"], "state": {"world_map.route": ["prt_fild08", "prontera", "geffen"]}}},
    {"move": [40, 740]},
    {"shot": "worldmap-route", "crop": [420, 330, 460, 320], "threshold": 2},
    {"key": "Escape"},
    {"wait": 300},
    {"key": "Escape"},
    {"wait": 300},
    {"click_on": {"button": "ok"}},
    {"wait": 300},
    {"expect": {"state": {"navigation": null}}},
    {"click_on": {"button": "minimap_viewon"}},
    {"wait": 600},
    {"expect": {"state": {"world_map.route": []}}},
    {"key": "Escape"},
    {"wait": 300},
    {"key": "Escape"},
    {"wait": 300},
    {"expect": {"windows_closed": ["WorldMap", "Navigation"]}}
  ]
}
