{
  "about": "A party member dragged out of the party window (issue #318) keeps a small HP window: 174×52 in the first free grid cell, (0, 275) at 1024×768, then dragged to about (180, 330) it snaps to (177, 330) (issue #483). Damaging them updates it from the same party HP packet, and it goes when they leave.",
  "account": "",
  "slot": 0,
  "second": {
    "account": "2",
    "slot": 0,
    "env": {
      "RUSTNAROK_CLIENT_PARTY": "accept,window"
    }
  },
  "steps": [
    {"say": "@warp prontera 156 180"},
    {"settle": 1500},
    {"type": "/leave"},
    {"key": "Enter"},
    {"as": "second", "type": "/leave"},
    {"as": "second", "key": "Enter"},
    {"wait": 1500},
    {"say": "@recall {second}"},
    {"as": "second", "settle": 2000},
    {"type": "/organize QAParty"},
    {"key": "Enter"},
    {"wait": 1500},
    {"expect": {"windows_open": ["Party"]}},
    {"key": "Alt+Z"},
    {"click_on": {"unit": "{second}"}, "button": "right"},
    {"wait": 400},
    {"click_on": {"menu_item": "party"}},
    {"wait": 2500},
    {"expect": {"chat": "accepted your party invitation."}},
    {"key": "Alt+Z"},
    {"wait": 600},
    {"drag_on": [{"button": "member:{second}"}, {"point": [40, 200]}]},
    {"wait": 300},
    {"expect": {"windows_open": ["PartyHp:{second}"], "state": {"small_windows.{second}": [0, 275]}}},
    {"drag_on": [{"button": "party_hp:{second}"}, {"point": [190, 340]}]},
    {"wait": 300},
    {"expect": {"state": {"small_windows.{second}": [177, 330]}}},
    {"as": "second", "say": "@heal"},
    {"wait": 800},
    {"as": "second", "say": "@heal -30 0"},
    {"wait": 1200},
    {"expect": {"windows_open": ["PartyHp:{second}"], "state": {"party.wounded": ["{second}"]}}},
    {"move": [1000, 740]},
    {"shot": "party-member-hp", "crop": [177, 330, 174, 52]},
    {"as": "second", "type": "/leave"},
    {"as": "second", "key": "Enter"},
    {"wait": 800},
    {"expect": {"windows_closed": ["PartyHp:{second}"]}},
    {"type": "/leave"},
    {"key": "Enter"},
    {"wait": 400}
  ]
}
