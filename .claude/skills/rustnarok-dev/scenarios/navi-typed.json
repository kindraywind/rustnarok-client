{
  "about": "Navigations typed in the chat, as the game's help on navigation writes them. On Morroc's road, /navi morocc 150/110 starts one to that cell (the arrow over the player, the trail on the minimap), says \"Navigation >: Please go to indicated direction.\" and opens no window; /navi2 with its scroll/Kafra/airship options starts another; an x and y without the \"/\" get \"Invalid syntax\"; a bare /navi is no command; a map the navigation tables don't have gets nothing at all; /naviopen opens the window. While a navigation runs, Esc on the window asks \"Do you want to cancel navigation?\": OK ends it and the window stays, and the next Esc closes the window. With no window, Esc asks too, before the game menu. A walk ordered to within five cells of the cell ends a navigation with \"Arrived at the target map.\"",
  "account": "",
  "slot": 0,
  "steps": [
    {"say": "@warp morocc 160 120"},
    {"settle": 1500},
    {"move": [1000, 600]},
    {"say": "/navi morocc 150/110"},
    {"wait": 1000},
    {"expect": {"chat": "Navigation >: Please go to indicated direction.", "state": {"navigation.map": "morocc", "navigation.cell": [150, 110]}, "state_at_least": {"navigation.trail": 1}, "windows_closed": ["Navigation"]}},
    {"shot": "navi-typed"},
    {"say": "/navi2 morocc 170/130 1/1/1"},
    {"wait": 500},
    {"expect": {"state": {"navigation.map": "morocc", "navigation.cell": [170, 130]}, "windows_closed": ["Navigation"]}},
    {"say": "/navi morocc 150 110"},
    {"wait": 300},
    {"expect": {"chat": "Navigation >: Invalid syntax", "state": {"navigation.cell": [170, 130]}}},
    {"say": "/navi"},
    {"wait": 300},
    {"expect": {"chat": "Invalid Command", "windows_closed": ["Navigation"], "state": {"navigation.cell": [170, 130]}}},
    {"say": "/navi nosuchmap 10/10"},
    {"wait": 300},
    {"expect": {"state": {"navigation.cell": [170, 130]}}},
    {"say": "/naviopen"},
    {"wait": 500},
    {"expect": {"windows_open": ["Navigation"]}},
    {"key": "Escape"},
    {"wait": 300},
    {"expect": {"windows_open": ["Navigation", "PartyAsked"], "state": {"navigation.cell": [170, 130]}}},
    {"shot": "navi-cancel-asked"},
    {"click_on": {"button": "ok"}},
    {"wait": 300},
    {"expect": {"windows_open": ["Navigation"], "windows_closed": ["PartyAsked"], "state": {"navigation": null}}},
    {"key": "Escape"},
    {"wait": 300},
    {"expect": {"windows_closed": ["Navigation"], "state": {"escape": null}}},
    {"say": "/navi morocc 160/130"},
    {"wait": 500},
    {"expect": {"state": {"navigation.cell": [160, 130]}}},
    {"key": "Escape"},
    {"wait": 300},
    {"expect": {"windows_open": ["PartyAsked"], "state": {"escape": null}}},
    {"click_on": {"button": "cancel"}},
    {"wait": 300},
    {"expect": {"windows_closed": ["PartyAsked"], "state": {"navigation.cell": [160, 130]}, "no_chat": "Arrived at the target map."}},
    {"click_on": {"cell": [160, 126]}},
    {"wait_for": {"sent": "0x035f", "ms": 3000}},
    {"wait": 1000},
    {"expect": {"chat": "Arrived at the target map.", "state": {"navigation": null}}}
  ]
}
