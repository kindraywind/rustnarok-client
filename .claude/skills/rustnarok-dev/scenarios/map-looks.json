{
  "about": "The looks of the maps' own effect objects that are neither emitters nor STRs. Prontera's chimneys smoke (152 objects; the puffs start 50 ticks after the load and show within 130 units). Byalan's fireflies glint for 2 seconds of every 8. Manuk's stones glow (sized by each object's first parameter). Nidhoggur's Nest has swarms of yellow flies (sixteen to an object) and lone ones; Lasagna's fields white ones. The Endless Tower's first floor has red torches and dust, its other end green ones; a Splendide house violet ones. The motion, the fades and the timing are checked by unit tests; flies, fireflies and puffs start by chance, so the shots differ from run to run.",
  "account": "",
  "slot": 0,
  "env": {"RUSTNAROK_CLIENT_CAMERA": "0,60,260"},
  "steps": [
    {"say": "@alive"},
    {"say": "@warp prontera 200 200"}, {"settle": 1500},
    {"wait": 3000},
    {"expect": {"map": "prontera.gat", "state": {"player.cell": [200, 200], "map_looks.smokes": 152}, "state_at_least": {"map_looks.smoke_sprites": 2}}},
    {"shot": "map-looks-chimneys", "crop": [330, 150, 420, 250], "threshold": 100},
    {"say": "@warp iz_dun00 262 78"}, {"settle": 1500},
    {"wait": 9000},
    {"expect": {"map": "iz_dun00.gat", "state_at_least": {"map_effects_fired": 5, "map_looks.fireflies": 1, "map_looks.firefly_sprites": 1}}},
    {"shot": "map-looks-fireflies", "threshold": 100},
    {"say": "@warp manuk 256 197"}, {"settle": 1500},
    {"wait": 2000},
    {"expect": {"map": "manuk.gat", "state_at_least": {"map_looks.glows": 10, "map_looks.squares_ready": 10}}},
    {"shot": "map-looks-glows", "crop": [300, 430, 724, 338], "threshold": 100},
    {"say": "@warp nyd_dun01 140 97"}, {"settle": 1500},
    {"say": "@killmonster2"},
    {"wait": 4000},
    {"expect": {"map": "nyd_dun01.gat", "state_at_least": {"map_looks.swarms": 5, "map_looks.squares_ready": 16}}},
    {"shot": "map-looks-yellow-flies", "threshold": 100},
    {"say": "@warp lasa_fild01 70 215"}, {"settle": 1500},
    {"say": "@killmonster2"},
    {"wait": 4000},
    {"expect": {"map": "lasa_fild01.gat", "state_at_least": {"map_looks.swarms": 1, "map_looks.squares_ready": 16}}},
    {"shot": "map-looks-white-flies", "threshold": 100},
    {"say": "@warp 1@tower 18 388"}, {"settle": 1500},
    {"wait": 2000},
    {"expect": {"map": "1@tower.gat", "state": {"player.cell": [18, 388]}, "state_at_least": {"map_looks.torches": 4, "map_looks.squares_ready": 4}}},
    {"shot": "map-looks-red-torches", "crop": [150, 130, 874, 400], "threshold": 100},
    {"say": "@warp 1@tower 370 50"}, {"settle": 1500},
    {"wait": 2000},
    {"expect": {"state_at_least": {"map_looks.torches": 8, "map_looks.squares_ready": 4}}},
    {"shot": "map-looks-green-torches", "threshold": 100},
    {"say": "@warp spl_in01 164 203"}, {"settle": 1500},
    {"wait": 2000},
    {"expect": {"map": "spl_in01.gat", "state_at_least": {"map_looks.torches": 4, "map_looks.squares_ready": 4}}},
    {"shot": "map-looks-violet-torches", "threshold": 100},
    {"say": "@heal"}
  ]
}
