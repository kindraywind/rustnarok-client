      }
    },
    {
      "shot": "pvp-off",
      "crop": [
        824,
        140,
        200,
        80
      ]
    },
    {
      "say": "@pvpon"
    },
    {
      "wait": 1500
    },
    {
      "expect": {
        "state": {
          "pvp_rank": [
            1,
            2
          ]
        }
      }
    },
    {
      "say": "@warp guild_vs1"
    },
    {
      "settle": 1500
    },
    {
      "say": "@recall {second}"
    },
    {
      "as": "second",
      "settle": 2000
    },
    {
      "wait": 800
    },
    {
      "expect": {
        "state": {
          "map_property": {
