    {"shot": "cutin-type-2", "crop": [424, 168, 600, 600], "threshold": 5},
    {"drag": [[824, 600], [724, 550]]}, {"wait": 300},
    {"expect": {"state": {"cutin_window.at": [564.0, 238.0]}}},
    {"key": "Enter"}, {"wait": 800},
    {"expect": {"state": {"dialog.lines.0": "The same picture again.", "cutin_window.at": [564.0, 238.0]}}},
    {"key": "Enter"}, {"wait": 800},
    {"expect": {"state": {"cutin_window.kind": 0, "cutin_window.at": [40.0, 288.0]}}},
    {"move": [1000, 10]}, {"wait": 200},
    {"shot": "cutin-type-0", "crop": [0, 168, 600, 600], "threshold": 5},
    {"key": "Enter"}, {"wait": 800},
    {"expect": {"state": {"cutin_window.kind": 3, "cutin_window.at": [352.0, 127.0], "cutin_window.height": 497.0}}},
    {"move": [1000, 10]}, {"wait": 200},
    {"shot": "cutin-type-3", "crop": [262, 100, 500, 560], "threshold": 5},
    {"click_on": {"button": "cutin_close"}}, {"wait": 300},
    {"expect": {"state": {"cutin": false}}},
    {"key": "Enter"}, {"wait": 800},
    {"key": "Enter"}, {"wait": 500},
    {"expect": {"windows_closed": ["NpcDialog"]}},
    {"say": "@unloadnpcfile {repo}/.claude/skills/rustnarok-dev/npc/cutin.txt"}, {"wait": 500}
  ]
