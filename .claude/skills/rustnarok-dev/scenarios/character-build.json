{
  "about": "Rebuilding a character by name, as an AI over the control socket would: the first account becomes a Wizard, @reset frees its stat points and it gets 5 skill points, then the status window's raise_int and the skill window's skill_tab:2 and two clicks on Fire Bolt (19) put them in pending (Fire Wall hovered lights what it needs) and skill_apply (answered Yes) spends them, read back from the state's stats and skill points. Ends a Novice with its stats reset and no skill points.",
  "account": "",
  "slot": 0,
  "steps": [
    {"say": "@job 9"},
    {"wait": 800},
    {"say": "@reset"},
    {"wait": 800},
    {"say": "@skpoint -9999"},
    {"wait": 500},
    {"say": "@skpoint 5"},
    {"wait": 800},
    {"expect": {"state": {"player.stats.int.value": 1, "player.skill_points": 5}}},
    {"key": "Alt+A"},
    {"wait": 500},
    {"click_on": {"button": "raise_int"}},
    {"wait": 300},
    {"click_on": {"button": "raise_int"}},
    {"wait": 300},
    {"click_on": {"button": "raise_int"}},
    {"wait": 500},
    {"expect": {"state": {"player.stats.int.value": 4, "player.stats.int.cost": 2}}},
    {"move": [700, 600]},
    {"shot": "build-status", "crop": [200, 200, 280, 150]},
    {"key": "Alt+S"},
    {"wait": 500},
    {"click_on": {"button": "skill_tab:2"}},
    {"wait": 300},
    {"click_on": {"skill": 19}},
    {"wait": 600},
    {"click_on": {"skill": 19}},
    {"wait": 600},
    {"expect": {"state": {"player.skill_pending": [19, 19], "player.skill_points": 5}}},
    {"move": {"skill": 18}},
    {"wait": 300},
    {"shot": "build-skills-pending", "crop": [230, 70, 580, 420]},
    {"click_on": {"button": "skill_apply"}},
    {"wait": 300},
    {"expect": {"windows_open": ["SkillApplyAsked"]}},
    {"key": "Enter"},
    {"wait": 800},
    {"expect": {"state": {"player.skill_points": 3, "player.skill_pending": []}}},
    {"move": [700, 600]},
    {"shot": "build-skills", "crop": [230, 70, 580, 420]},
    {"say": "@reset"},
    {"wait": 500},
    {"say": "@skpoint -9999"},
    {"wait": 500},
    {"say": "@job 0"},
    {"wait": 500}
  ]
}
