    {"type": "/leave"}, {"key": "Enter"}, {"as": "second", "type": "/leave"}, {"as": "second", "key": "Enter"}, {"wait": 800},
    {"type": "/organize Crabs277"}, {"key": "Enter"}, {"wait_for": {"event": "PartyMade", "ms": 5000}}, {"wait": 500},
    {"key": "Ctrl+Z"}, {"wait": 1500},
    {"click_on": {"button": "booking_min"}}, {"key": "Backspace"}, {"key": "Backspace"}, {"key": "Backspace"}, {"type": "1"},
    {"click_on": {"button": "booking_max"}}, {"key": "Backspace"}, {"key": "Backspace"}, {"key": "Backspace"}, {"type": "99"},
    {"click_on": {"button": "booking_memo"}}, {"type": "come along"}, {"key": "Enter"},
    {"click_on": {"button": "booking_delete"}}, {"wait": 1500},
    {"click_on": {"button": "booking_post"}}, {"wait": 2500},
    {"expect": {"state": {"booking.posts": ["{first}"]}}},
    {"as": "second", "key": "Ctrl+Z"}, {"as": "second", "wait": 1500},
    {"as": "second", "click_on": {"button": "booking_min"}}, {"as": "second", "key": "Backspace"}, {"as": "second", "key": "Backspace"}, {"as": "second", "key": "Backspace"}, {"as": "second", "type": "1"},
    {"as": "second", "click_on": {"button": "booking_max"}}, {"as": "second", "key": "Backspace"}, {"as": "second", "key": "Backspace"}, {"as": "second", "key": "Backspace"}, {"as": "second", "type": "99"},
    {"as": "second", "key": "Enter"},
    {"as": "second", "click_on": {"button": "booking_search"}}, {"as": "second", "wait": 2500},
    {"as": "second", "expect": {"state": {"booking.posts": ["{first}"]}}},
    {"as": "second", "move": [1000, 740]},
    {"as": "second", "shot": "booking-found", "crop": [330, 130, 360, 330], "threshold": 5},
    {"as": "second", "click_on": {"button": "booking_join:{first}"}},
    {"wait_for": {"event": "BookingJoinAsked", "ms": 5000}}, {"wait": 500},
    {"expect": {"state": {"booking_asked": "{second}"}}},
    {"move": [1000, 740]},
    {"shot": "booking-asked", "crop": [262, 330, 500, 260], "threshold": 5},
    {"click_on": {"button": "ok"}},
    {"as": "second", "wait_for": {"event": "BookingJoinAnswered", "ms": 5000}}, {"as": "second", "wait": 800},
    {"as": "second", "expect": {"chat": "{first} let you join Crabs277"}},
    {"click_on": {"button": "booking_delete"}}, {"wait": 1500},
    {"expect": {"state": {"booking.posts": []}}},
    {"as": "second", "type": "/leave"}, {"as": "second", "key": "Enter"}, {"wait": 800},
    {"type": "/leave"}, {"key": "Enter"}, {"wait": 800}
  ]
