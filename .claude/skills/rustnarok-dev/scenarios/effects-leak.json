    {"settle": 1500},
    {"say": "@unloadnpcfile {repo}/.claude/skills/rustnarok-dev/npc/effects-leak.txt"},
    {"wait": 300},
    {"say": "@loadnpc {repo}/.claude/skills/rustnarok-dev/npc/effects-leak.txt"},
