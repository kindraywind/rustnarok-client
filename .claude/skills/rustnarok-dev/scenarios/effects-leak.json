    {"move": [1000, 600]},
    {"click_on": {"cell": [125, 140]}},
    {"wait": 2000},
    {"expect": {"state": {"player.cell": [125, 140]}, "state_at_least": {"effects_alive.status_prims_by.254/me": 1}}},
    {"shot": "glints-on", "crop": [312, 184, 400, 400], "threshold": 30},
    {"click_on": {"cell": [127, 140]}},
    {"wait": 2500},
    {"expect": {"state": {"player.cell": [127, 140], "effects_alive.status_prims_by.254/me": null}}},
    {"shot": "glints-off", "crop": [312, 184, 400, 400], "threshold": 30},
    {"say": "@unloadnpcfile {repo}/.claude/skills/rustnarok-dev/npc/effects-leak.txt"},
    {"wait": 300}
  ]
