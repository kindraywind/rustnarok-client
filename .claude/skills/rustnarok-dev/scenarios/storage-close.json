{
  "about": "Closing the storage. @storage opens it at (360, 200); it is dragged left by its title. Esc with nothing else open brings up the game menu, which takes every click while it's up: Close sends nothing and `windows` lists GameMenu. With the menu shut, Close sends CZ_CLOSE_STORE 0x0193 and the window goes on the server's answer; so does the title's close, with the window where it was dragged.",
  "account": "",
  "slot": 0,
  "steps": [
    {"say": "@warp prontera 156 180"},
    {"settle": 1500},
    {"say": "@storage"},
    {"wait_for": {"packet": "0x0b08", "ms": 8000}},
    {"wait": 500},
    {"expect": {"windows_open": ["Storage"], "windows_closed": ["Inventory"], "state": {"escape": null}}},
    {"drag": [[560, 208], [300, 208]]},
    {"wait": 300},
    {"key": "Escape"},
    {"wait": 300},
    {"expect": {"windows_open": ["Storage", "GameMenu"]}},
    {"move": [1000, 750]},
    {"shot": "storage-under-menu"},
    {"click_on": {"button": "storage_close"}},
    {"wait_for": {"sent": "0x0193", "ms": 1000}, "none": true},
    {"expect": {"windows_open": ["Storage", "GameMenu"]}},
    {"key": "Escape"},
    {"wait": 300},
    {"expect": {"windows_open": ["Storage"], "windows_closed": ["GameMenu"]}},
    {"click_on": {"button": "storage_close"}},
    {"wait_for": {"sent": "0x0193", "ms": 2000}},
    {"wait_for": {"event": "StorageClosed", "ms": 3000}},
    {"expect": {"windows_closed": ["Storage"]}},
    {"say": "@storage"},
    {"wait_for": {"packet": "0x0b08", "ms": 8000}},
    {"wait": 500},
    {"expect": {"windows_open": ["Storage"], "button": {"name": "storage_title_close", "box": [366, 203, 11, 11]}}},
    {"click_on": {"button": "storage_title_close"}},
    {"wait_for": {"sent": "0x0193", "ms": 2000}},
    {"wait_for": {"event": "StorageClosed", "ms": 3000}},
    {"expect": {"windows_closed": ["Storage"]}}
  ]
}
