{
  "about": "Swap Equipment (issue #112): a Swordman wears a Knife, opens the swap view from the equipment window's swap button, drags a Sword into the set and switches: the Sword is worn and the Knife goes into the set. @refresh sends the set again. A double click takes the Knife out; switching an empty set says there is nothing to replace. rathena saves the set in inventory.equip_switch: the scenario reset should set it to 0 for the test characters.",
  "account": "",
  "slot": 0,
  "steps": [
    {"say": "@warp prt_fild08 170 360"}, {"settle": 1500},
    {"say": "@itemreset"}, {"wait": 800},
    {"say": "@job 1"}, {"wait": 800},
    {"say": "@item 1101"}, {"wait_for": {"event": "PickedUp", "ms": 5000}},
    {"say": "@item 1201"}, {"wait_for": {"event": "PickedUp", "ms": 5000}},
    {"key": "Alt+E"}, {"wait": 400},
    {"click": [11, 225]}, {"wait": 300},
    {"click_on": {"inventory_item": 1201}, "count": 2}, {"wait": 600},
    {"expect": {"inventory_has": [{"id": 1201, "worn": 2}]}},
    {"key": "Alt+Q"}, {"wait": 400},
    {"click_on": {"button": "swap"}}, {"wait": 300},
    {"expect": {"windows_open": ["SwapEquipment"]}},
    {"drag_on": [{"inventory_item": 1101}, {"point": [540, 300]}]}, {"wait_for": {"packet": "0x0a98", "ms": 5000}}, {"wait": 300},
    {"expect": {"inventory_has": [{"id": 1101, "switch": 2}], "chat": "have been placed on the Swap Equipment window"}},
    {"move": [1000, 750]},
    {"shot": "swap-set", "crop": [0, 150, 780, 260]},
    {"click_on": {"button": "switch_all"}}, {"wait_for": {"packet": "0x0a98", "ms": 5000}}, {"wait": 500},
    {"expect": {"inventory_has": [{"id": 1101, "worn": 2, "switch": 0}, {"id": 1201, "worn": 0, "switch": 2}]}},
    {"move": [1000, 750]},
    {"shot": "switched", "crop": [0, 150, 780, 260]},
    {"say": "@refresh"}, {"wait_for": {"packet": "0x0a9b", "ms": 5000}}, {"wait": 500},
    {"expect": {"inventory_has": [{"id": 1201, "switch": 2}]}},
    {"click": [540, 300], "count": 2}, {"wait_for": {"packet": "0x0a9a", "ms": 5000}}, {"wait": 300},
    {"expect": {"inventory_has": [{"id": 1201, "switch": 0}], "chat": "have been removed from the Swap Equipment window"}},
    {"click_on": {"button": "switch_all"}}, {"wait": 300},
    {"expect": {"chat": "There is no item to replace."}},
    {"click_on": {"button": "swap"}}, {"wait": 300},
    {"expect": {"windows_closed": ["SwapEquipment"]}},
    {"key": "Alt+Q"}, {"wait": 300},
    {"key": "Alt+E"}, {"wait": 300},
    {"say": "@itemreset"}, {"wait": 800},
    {"say": "@job 0"}, {"wait": 800}
  ]
}
