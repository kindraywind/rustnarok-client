{
  "about": "A <NAVI> link's fields after its x and y. Our NPC's text has three links: one that ends at y names the NPC on that cell, and with nobody there the chat says \"Navigation >: No Information\" and nothing starts; one whose options are -222 opens the Navigation window with the map's name looked up, and starts nothing; one with type 1, options 101 and the window field set starts a navigation to the map itself and opens the window. (The link navigation.json clicks, ...,0,000,0, is a cell with no window.) The script is unloaded at the end.",
  "account": "",
  "slot": 0,
  "steps": [
    {"say": "@warp prt_fild08 190 340"},
    {"settle": 1500},
    {"say": "@killmonster2"},
    {"wait": 300},
    {"say": "@unloadnpcfile {repo}/.claude/skills/rustnarok-dev/npc/navigation.txt"},
    {"wait": 500},
    {"say": "@loadnpc {repo}/.claude/skills/rustnarok-dev/npc/navigation.txt"},
    {"wait": 1500},
    {"click_on": {"unit": "Navi Board"}},
    {"wait_for": {"packet": "0x00b4", "ms": 3000}},
    {"wait": 600},
    {"click_on": {"navi_link": "geffen"}},
    {"wait": 400},
    {"expect": {"chat": "Navigation >: No Information", "state": {"navigation": null}, "windows_closed": ["Navigation"]}},
    {"click_on": {"navi_link": "izlude"}},
    {"wait": 400},
    {"expect": {"windows_open": ["Navigation"], "state": {"navigation": null}, "button": {"name": "navi_result_0", "map": "izlude", "target_kind": "map"}}},
    {"move": [1000, 740]},
    {"shot": "navi-link-search", "threshold": 3},
    {"click_on": {"button": "navi_result_0"}},
    {"wait": 400},
    {"click_on": {"button": "navi_stop"}},
    {"wait": 300},
    {"key": "Escape"},
    {"wait": 300},
    {"expect": {"windows_closed": ["Navigation"], "state": {"navigation": null}}},
    {"click_on": {"navi_link": "payon"}},
    {"wait": 600},
    {"expect": {"chat": "Navigation >: A route was found", "windows_open": ["Navigation"], "state": {"navigation.map": "payon", "navigation.cell": null}}},
    {"click_on": {"button": "navi_stop"}},
    {"wait": 300},
    {"key": "Escape"},
    {"wait": 300},
    {"key": "Enter"},
    {"wait": 500},
    {"say": "@unloadnpcfile {repo}/.claude/skills/rustnarok-dev/npc/navigation.txt"},
    {"wait": 500}
  ]
}
