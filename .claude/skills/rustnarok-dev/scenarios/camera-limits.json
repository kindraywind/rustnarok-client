    {"expect": {"state": {"camera.distance": 400}}},
    {"wait": 1500}, {"move": [1000, 750]},
    {"shot": "camera-far-low", "threshold": 20},
    {"wheel": [700, 400, 1]}, {"wait": 200},
    {"expect": {"state": {"camera.distance": 375.7}}},
    {"click": [700, 400], "button": "right", "mods": "Ctrl", "count": 2}, {"wait": 200},
    {"click": [700, 400], "button": "right", "mods": "Shift", "count": 2}, {"wait": 200},
    {"click": [700, 400], "button": "right", "count": 2}, {"wait": 200},
    {"expect": {"state": {"camera.yaw": 0, "camera.pitch": 50, "camera.distance": 300}}}
  ]
