{
  "about": "Share in the Navigation window, and a shared place in the chat. With a map picked, Share turns the window to the share view: the map's picture, lines through the pointer, and for a few seconds the hint that a click shares the spot. A click on the picture puts that cell's link on the chat line (nothing is sent) and the search view is back. Sent, the line shows the place as \"<map x,y>\". A click on it opens the window with that cell as its only row, picked, and starts nothing; Find then goes there. With a monster picked, Share puts its map's link on the chat line at once, which shows as \"<map>\".",
  "account": "",
  "slot": 0,
  "steps": [
    {"say": "@warp prt_fild08 190 340"},
    {"settle": 1500},
    {"say": "/naviopen"},
    {"wait": 500},
    {"type": "prt_fild08"},
    {"key": "Enter"},
    {"wait": 300},
    {"click_on": {"button": "navi_group_0"}},
    {"wait": 300},
    {"expect": {"button": {"name": "navi_member_0", "map": "prt_fild08", "place_kind": 1}}},
    {"click_on": {"button": "navi_share"}},
    {"wait": 300},
    {"expect": {"state": {"navi_window.sharing": true, "chat_input": ""}, "no_target": {"button": "navi_find"}}},
    {"move": [470, 330]},
    {"wait": 200},
    {"shot": "navi-share-view", "crop": [366, 205, 292, 358], "threshold": 2},
    {"click_on": {"button": "navi_share_map"}},
    {"wait": 300},
    {"expect": {"state": {"navi_window.sharing": false, "chat_input": "<NAVIL>prt_fild083e3d</NAVIL>", "navigation": null}}},
    {"key": "Enter"},
    {"wait": 600},
    {"expect": {"chat": "McpTester : <NAVIL>prt_fild083e3d</NAVIL>"}},
    {"key": "Escape"},
    {"wait": 300},
    {"expect": {"windows_closed": ["Navigation"]}},
    {"click_on": {"place_link": "prt_fild08"}},
    {"wait": 400},
    {"expect": {"windows_open": ["Navigation"], "state": {"navi_window.rows": 1, "navi_window.row": 0, "navigation": null}, "button": {"name": "navi_member_0", "map": "prt_fild08", "place_kind": 0}}},
    {"move": [1000, 740]},
    {"shot": "navi-share-opened", "threshold": 3},
    {"click_on": {"button": "navi_find"}},
    {"wait": 500},
    {"expect": {"chat": "Navigation >: Please go to indicated direction.", "state": {"navigation.map": "prt_fild08", "navigation.cell": [200, 199]}}},
    {"key": "Escape"},
    {"wait": 300},
    {"click_on": {"button": "ok"}},
    {"wait": 300},
    {"expect": {"windows_open": ["Navigation"], "state": {"navigation": null}}},
    {"click_on": {"button": "navi_field"}},
    {"type": "prt_fild08"},
    {"key": "Enter"},
    {"wait": 300},
    {"click_on": {"button": "navi_group_0"}},
    {"wait": 300},
    {"expect": {"button": {"name": "navi_member_1", "place_kind": 3}}},
    {"click_on": {"button": "navi_member_1"}},
    {"wait": 200},
    {"click_on": {"button": "navi_share"}},
    {"wait": 300},
    {"expect": {"state": {"navi_window.sharing": false, "chat_input": "<NAVIL>prt_fild08g8g8</NAVIL>"}}},
    {"key": "Enter"},
    {"wait": 600},
    {"expect": {"chat": "McpTester : <NAVIL>prt_fild08g8g8</NAVIL>"}},
    {"key": "Escape"},
    {"wait": 300},
    {"expect": {"windows_closed": ["Navigation"]}}
  ]
}
