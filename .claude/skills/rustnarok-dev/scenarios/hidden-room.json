    {"move": [1000, 750]},
    {"expect": {"button": {"name": "room_sign"}}},
    {"shot": "hidden-room-board", "crop": [400, 230, 450, 260]},
    {"click_on": {"button": "room_sign"}},
    {"wait": 1500},
    {"expect": {"windows_open": ["ChatRoom"]}},
    {"shot": "hidden-room-joined"},
    {"key": "Escape"},
    {"wait": 800},
    {"expect": {"windows_closed": ["ChatRoom"], "button": {"name": "room_sign"}}},
    {"say": "@unloadnpcfile {repo}/.claude/skills/rustnarok-dev/npc/hidden-room.txt"},
    {"wait": 300}
  ]
