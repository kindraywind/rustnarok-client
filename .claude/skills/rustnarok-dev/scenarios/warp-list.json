    {"say": "@itemreset"}, {"wait": 800},
    {"type": "/memo"}, {"key": "Enter"}, {"wait_for": {"packet": "0x011e", "ms": 5000}},
    {"expect": {"chat": "Current location is saved as a Memo Point"}},
