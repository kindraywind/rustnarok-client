    {"click_on": {"skill": 26}, "count": 2}, {"wait_for": {"packet": "0x0abe", "ms": 5000}},
    {"key": "Alt+S"}, {"wait": 300}, {"move": [900, 700]},
    {"expect": {"windows_open": ["WarpList"]}},
    {"shot": "teleport-list", "crop": [330, 450, 300, 140]},
    {"key": "Escape"}, {"wait": 500},
    {"expect": {"windows_closed": ["WarpList"], "map": "izlude.gat"}},
    {"key": "Alt+S"}, {"wait": 500},
    {"click_on": {"skill": 27}, "count": 2}, {"wait": 300},
    {"key": "Alt+S"}, {"wait": 300},
    {"click": [620, 330]}, {"wait_for": {"packet": "0x0abe", "ms": 8000}},
    {"move": [900, 700]}, {"wait": 300},
    {"expect": {"windows_open": ["WarpList"]}},
    {"shot": "warp-portal-list", "crop": [330, 450, 300, 140]},
    {"key": "Down"}, {"key": "Enter"}, {"wait_for": {"event": "SkillUnit", "ms": 5000}},
    {"wait_for": {"packet": "0x01d7", "ms": 5000}}, {"wait": 1500},
    {"expect": {"windows_closed": ["WarpList"]}},
    {"shot": "warp-portal-open", "crop": [440, 120, 360, 300], "threshold": 5},
    {"say": "@job 0"}, {"wait": 500}
  ]
