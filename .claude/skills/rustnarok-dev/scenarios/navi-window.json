{
  "about": "The Navigation window. /naviopen opens it in the middle of the screen with the search box taking the keys. Typing doesn't search; Enter does (and the Search button): \"izlude\" finds maps, each a row of its own in the left list (\"[n]name\": the map and the monsters it brought), and the label counts the rows. A row picked fills the right list with its places and shows the first one's name and map picture; a place picked there is the target. Nothing starts until Find: then the chat says the route and the navigation runs, by warps only unless the service box is ticked. The type box narrows the rows to maps, NPCs or monsters without searching again. The window moves by any spot that's no control, and while a navigation runs its close button asks before cancelling.",
  "account": "",
  "slot": 0,
  "steps": [
    {"say": "@warp prt_fild08 190 340"},
    {"settle": 1500},
    {"say": "/naviopen"},
    {"wait": 500},
    {"expect": {"windows_open": ["Navigation"], "state": {"navi_window.typing": true, "navi_window.rows": 0, "navi_window.position": [376.0, 215.0]}}},
    {"type": "izlude"},
    {"wait": 300},
    {"expect": {"state": {"navi_window.text": "izlude", "navi_window.rows": 0}}},
    {"key": "Enter"},
    {"wait": 300},
    {"expect": {"state_at_least": {"navi_window.rows": 1}, "state": {"navi_window.row": null, "navigation": null}}},
    {"click_on": {"button": "navi_find"}},
    {"wait": 300},
    {"expect": {"chat": "Navigation >: Failed to set info for location!", "state": {"navigation": null}}},
    {"click_on": {"button": "navi_filter"}},
    {"wait": 200},
    {"click_on": {"button": "navi_filter_1"}},
    {"wait": 200},
    {"expect": {"state": {"navi_window.filter": 1}, "button": {"name": "navi_group_0", "place_kind": 1}}},
    {"click_on": {"button": "navi_group_0"}},
    {"wait": 300},
    {"expect": {"state": {"navi_window.row": 0, "navi_window.member": 0, "navigation": null}, "button": {"name": "navi_member_0", "place_kind": 1}}},
    {"move": [1000, 740]},
    {"shot": "navi-window-picked", "crop": [366, 205, 292, 358], "threshold": 2},
    {"click_on": {"button": "navi_find"}},
    {"wait": 500},
    {"expect": {"chat": "Navigation >: A route was found", "state_at_least": {"navigation.trail": 2}}},
    {"drag": [[500, 420], [560, 470]]},
    {"wait": 300},
    {"expect": {"state": {"navi_window.position": [436.0, 265.0]}}},
    {"key": "Escape"},
    {"wait": 300},
    {"expect": {"windows_open": ["Navigation", "PartyAsked"]}},
    {"click_on": {"button": "ok"}},
    {"wait": 300},
    {"expect": {"windows_open": ["Navigation"], "state": {"navigation": null}}},
    {"click_on": {"button": "navi_service"}},
    {"wait": 200},
    {"expect": {"state": {"navi_window.service": true}}},
    {"key": "Escape"},
    {"wait": 300},
    {"expect": {"windows_closed": ["Navigation"]}}
  ]
}
