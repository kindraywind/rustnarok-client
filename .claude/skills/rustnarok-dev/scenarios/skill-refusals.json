    {"say": "@allskill"},
    {"wait": 800},
    {"key": "Alt+S"},
    {"wait": 400},
    {"drag_on": [{"skill": 10}, {"hotkey": 0}]},
    {"wait": 400},
    {"key": "Alt+S"},
    {"wait": 300},
    {"expect": {"hotkeys": {"0": 10}, "state": {"player.skill_fail": true}}},
