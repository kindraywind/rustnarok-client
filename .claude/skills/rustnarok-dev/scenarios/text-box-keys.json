    {"expect": {"state": {"shortcuts.hotbar_1_1": "Shift+F1"}}},
    {"say": "@itemreset"}, {"wait": 800},
    {"say": "@item 501 5"}, {"wait_for": {"event": "PickedUp", "ms": 5000}},
    {"say": "@heal -30 0"}, {"wait": 400},
    {"key": "Alt+E"}, {"wait": 300},
    {"drag_on": [{"inventory_item": 501}, {"hotkey": 0}]}, {"wait": 300},
    {"key": "Alt+E"}, {"wait": 300},
    {"expect": {"state": {"chat_line_open": true}}},
    {"key": "Shift+F1"}, {"wait_for": {"sent": "0x0439", "ms": 1500}, "none": true},
    {"expect": {"inventory_has": [{"id": 501, "amount": 5}]}},
    {"say": "@itemreset"}, {"wait": 500}
  ]
