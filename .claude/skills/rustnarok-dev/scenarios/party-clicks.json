    {"as": "second", "say": "@allskill"}, {"as": "second", "wait": 500},
    {"as": "second", "key": "Alt+S"}, {"as": "second", "wait": 400},
    {"as": "second", "drag_on": [{"skill": 5}, {"hotkey": 1}]}, {"as": "second", "wait": 300},
    {"as": "second", "key": "Alt+S"}, {"as": "second", "wait": 300},
    {"as": "second", "click_on": {"hotkey": 1}, "count": 2}, {"as": "second", "wait": 300},
    {"as": "second", "expect": {"state": {"player.aiming.skill": 5}}},
