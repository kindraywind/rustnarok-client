    {"click_on": {"menu_item": "party"}},
    {"wait_for": {"packet": "0x02c5", "ms": 5000}}, {"wait": 500},
    {"key": "Alt+Z"}, {"wait": 400},
    {"click_on": {"button": "leave"}}, {"wait": 300},
    {"expect": {"windows_open": ["PartyAsked"]}},
    {"click_on": {"button": "ok"}},
