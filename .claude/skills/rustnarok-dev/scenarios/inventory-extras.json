{
  "about": "Favourites tab, lock item drop, compare equips, and a card's picture (issue #319). It runs on a settings folder of its own, so the lock and Compare start off and stay out of other runs (issue #404).",
  "account": "",
  "slot": 0,
  "env": {"RUSTNAROK_CLIENT_SETTINGS": "{fresh}"},
  "steps": [
    {"say": "@warp iz_int01 18 26"},
    {"settle": 1500},
    {"say": "@heal"},
    {"wait": 300},
    {"say": "@itemreset"},
    {"wait": 800},
    {"say": "@item 501 5"},
    {"wait_for": {"event": "PickedUp", "ms": 5000}},
    {"say": "@item 1101 1"},
    {"wait_for": {"event": "PickedUp", "ms": 5000}},
    {"say": "@item 1101 1"},
    {"wait_for": {"event": "PickedUp", "ms": 5000}},
    {"say": "@item 4001 1"},
    {"wait_for": {"event": "PickedUp", "ms": 5000}},
    {"key": "Alt+E"},
    {"wait": 400},
    {"expect": {"windows_open": ["Inventory"], "inventory_has": [{"id": 501, "favorite": false}, {"id": 1101, "worn": 0}, {"id": 4001}]}},
    {"click_on": {"inventory_item": 501}, "button": "right", "mods": "shift"},
    {"wait_for": {"packet": "0x0908", "ms": 5000}},
    {"expect": {"inventory_has": [{"id": 501, "favorite": true}]}},
    {"click_on": {"button": "tab:favorite"}},
    {"wait": 300},
    {"move": {"inventory_item": 501}},
    {"shot": "favourites", "crop": [0, 150, 320, 180]},
    {"click_on": {"button": "lock_drop"}},
    {"wait": 200},
    {"drag_on": [{"inventory_item": 501}, {"point": [700, 520]}]},
    {"wait": 400},
    {"expect": {"windows_closed": ["Amount"], "state": {"ground_items": []}}},
    {"shot": "drop-locked", "crop": [0, 150, 320, 180]},
    {"click_on": {"button": "tab:etc"}},
    {"wait": 200},
    {"shot": "etc-without-favourite", "crop": [0, 150, 320, 180]},
    {"click_on": {"button": "tab:equip"}},
    {"wait": 200},
    {"click_on": {"inventory_item": 1101}, "count": 2},
    {"wait": 800},
    {"expect": {"inventory_has": [{"id": 1101, "worn": 2}, {"id": 1101, "worn": 0}]}},
    {"click_on": {"button": "compare"}},
    {"wait": 200},
    {"move": {"inventory_item": 1101}},
    {"wait": 200},
    {"shot": "compare-sword", "crop": [0, 140, 640, 420]},
    {"click_on": {"button": "tab:etc"}},
    {"wait": 200},
    {"click_on": {"inventory_item": 4001}, "button": "right"},
    {"wait": 400},
    {"expect": {"windows_open": ["ItemInfo"]}},
    {"click_on": {"button": "card_picture"}},
    {"wait": 400},
    {"expect": {"windows_open": ["CardPicture"]}},
    {"shot": "poring-card", "crop": [250, 120, 520, 420]},
    {"say": "@itemreset"},
    {"wait": 500}
  ]
}
