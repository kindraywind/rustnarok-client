{
  "about": "A whisper opens a 1:1 window when Open 1:1 Chat between Strangers is on, a reply typed there reaches the other player, an away message answers once, and /ex lists a blocked name with a button that allows it again (issue #316).",
  "account": "",
  "slot": 0,
  "second": {"account": "2", "slot": 0, "env": {"RUSTNAROK_CLIENT_PARTY": "friends"}},
  "steps": [
    {"say": "@warp prontera 156 180"}, {"settle": 1500},
    {"say": "@recall {second}"}, {"as": "second", "settle": 2000},
    {"as": "second", "click_on": {"button": "friendsetup"}},
    {"as": "second", "expect": {"windows_open": ["FriendSetup"]}},
    {"as": "second", "click_on": {"button": "strangers"}},
    {"as": "second", "expect": {"state": {"whisper_open.strangers": true, "whisper_open.friends": false}}},
    {"key": "Tab"}, {"type": "{second}"}, {"key": "Tab"}, {"type": "hi from {first}"}, {"key": "Enter"},
    {"as": "second", "wait_for": {"event": "Whisper", "ms": 5000}},
    {"as": "second", "expect": {"chat": "hi from {first}", "windows_open": ["Whisper:{first}"]}},
    {"as": "second", "click_on": {"button": "whisper_input:{first}"}},
    {"as": "second", "type": "back at you"}, {"as": "second", "key": "Enter"},
    {"wait_for": {"event": "Whisper", "ms": 5000}},
    {"expect": {"chat": "back at you"}},
    {"type": "/away"}, {"key": "Enter"},
    {"expect": {"windows_open": ["AwayMessage"]}},
    {"type": "be right back"}, {"key": "Enter"},
    {"expect": {"chat": "Away message: be right back", "windows_closed": ["AwayMessage"]}},
    {"as": "second", "click_on": {"button": "whisper_input:{first}"}},
    {"as": "second", "type": "you there"}, {"as": "second", "key": "Enter"},
    {"wait_for": {"event": "Whisper", "ms": 5000}},
    {"expect": {"chat": "Away: answered {second}"}},
    {"as": "second", "wait_for": {"event": "Whisper", "ms": 5000}},
    {"as": "second", "expect": {"chat": "be right back"}},
    {"type": "/ex Poring"}, {"key": "Enter"},
    {"wait_for": {"event": "WhisperSetting", "ms": 5000}},
    {"type": "/ex"}, {"key": "Enter"},
    {"wait_for": {"event": "WhisperList", "ms": 5000}},
    {"expect": {"windows_open": ["BlockList"], "state": {"block_names.0": "Poring"}}},
    {"click_on": {"button": "allow:Poring"}},
    {"wait_for": {"event": "WhisperSetting", "ms": 5000}},
    {"expect": {"state": {"block_names": []}}}
  ]
}
