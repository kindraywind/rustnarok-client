{
  "about": "NPC dialogs by keyboard and by named targets (issue #1036), with npc/dialog-keys.txt. Talk one, with 'hi' in the chat line: Space types a space there and leaves the dialog; Enter presses Next. A click on the npc_next target, then Enter right after the menu comes (inside the 300 ms wait): the Enter waits for the end of the wait and picks. The second menu's row is picked with its npc_menu:2 target and npc_menu_ok, the input box's OK with npc_input_ok, and npc_close closes. Talk two, with an empty chat line: Space presses Next, confirms the highlighted menu item, types a space into the input box, and closes. Main ignored Space with the always-open chat line, dropped an Enter inside the wait, and had no dialog targets.",
  "account": "",
  "slot": 0,
  "steps": [
    {"say": "@warp iz_int01 18 26"}, {"settle": 1500},
    {"say": "@unloadnpcfile {repo}/.claude/skills/rustnarok-dev/npc/dialog-keys.txt"}, {"wait": 500},
    {"say": "@loadnpc {repo}/.claude/skills/rustnarok-dev/npc/dialog-keys.txt"}, {"wait": 1000},

    {"type": "hi"},
    {"click_unit": {"kind": "npc", "name": "Key Clerk"}}, {"wait": 1000},
    {"expect": {"windows_open": ["NpcDialog"], "state": {"dialog.button": "next", "dialog.lines.1": "Page one.", "chat_input": "hi"}}},
    {"key": "Space"}, {"wait": 500},
    {"expect": {"state": {"dialog.button": "next", "dialog.lines.1": "Page one.", "chat_input": "hi "}}},
    {"key": "Enter"}, {"wait": 800},
    {"expect": {"state": {"dialog.lines": ["Page two."], "dialog.button": "next"}}},
    {"move": [900, 700]},
    {"shot": "npc-dialog-next-target", "crop": [190, 90, 300, 200], "threshold": 5},
    {"click_on": {"button": "npc_next"}},
    {"wait_for": {"event": "NpcMenu", "ms": 3000}},
    {"key": "Enter"}, {"wait": 1000},
    {"expect": {"state": {"dialog.menu": null, "dialog.lines.1": "Staying.", "dialog.button": "next"}}},
    {"click_on": {"button": "npc_next"}}, {"wait": 1000},
    {"expect": {"state": {"dialog.menu.items": ["A", "B", "C"], "dialog.menu.selected": 0}}},
    {"click_on": {"button": "npc_menu:2"}}, {"wait": 400},
    {"expect": {"state": {"dialog.menu.selected": 2}}},
    {"move": [900, 700]},
    {"shot": "npc-dialog-menu-target", "crop": [190, 90, 300, 340], "threshold": 5},
    {"click_on": {"button": "npc_menu_ok"}}, {"wait": 1000},
    {"expect": {"state": {"dialog.menu": null, "dialog.input.typed": ""}}},
    {"type": "x"},
    {"click_on": {"button": "npc_input_ok"}}, {"wait": 1000},
    {"expect": {"state": {"dialog.input": null, "dialog.button": "close", "chat_input": "hi "}}},
    {"click_on": {"button": "npc_close"}}, {"wait": 800},
    {"expect": {"windows_closed": ["NpcDialog"]}},

    {"key": "Backspace"}, {"key": "Backspace"}, {"key": "Backspace"}, {"wait": 200},
    {"expect": {"state": {"chat_input": ""}}},
    {"click_unit": {"kind": "npc", "name": "Key Clerk"}}, {"wait": 1000},
    {"key": "Space"}, {"wait": 800},
    {"expect": {"state": {"dialog.lines": ["Page two."], "dialog.button": "next"}}},
    {"key": "Space"}, {"wait": 800},
    {"expect": {"state": {"dialog.menu.items": ["Stay", "Leave", "Wave"]}}},
    {"key": "ArrowDown"}, {"wait": 200},
    {"key": "Space"}, {"wait": 800},
    {"expect": {"state": {"dialog.menu": null, "dialog.lines.1": "Leaving."}}},
    {"key": "Space"}, {"wait": 800},
    {"key": "Space"}, {"wait": 800},
    {"expect": {"state": {"dialog.menu": null, "dialog.input.typed": ""}}},
    {"type": "a"}, {"key": "Space"}, {"type": "b"}, {"wait": 200},
    {"expect": {"state": {"dialog.input.typed": "a b"}}},
    {"move": [900, 700]},
    {"shot": "npc-dialog-input-space", "crop": [190, 90, 520, 340], "threshold": 5},
    {"key": "Enter"}, {"wait": 1000},
    {"expect": {"state": {"dialog.button": "close"}}},
    {"key": "Space"}, {"wait": 800},
    {"expect": {"windows_closed": ["NpcDialog"]}},
    {"say": "@unloadnpcfile {repo}/.claude/skills/rustnarok-dev/npc/dialog-keys.txt"}, {"wait": 500}
  ]
}
