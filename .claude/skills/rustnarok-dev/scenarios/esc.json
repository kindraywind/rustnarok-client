{
  "about": "Esc closes the window last opened or clicked, one per press, then opens the game menu. A question is answered No. Dead, the menu is save point and return; a Token of Siegfried adds resurrect here (issue #178).",
  "account": "",
  "slot": 0,
  "steps": [
    {"say": "@warp iz_int01 18 26"},
    {"settle": 1500},
    {"say": "@heal"},
    {"wait": 400},
    {"key": "Alt+E"},
    {"wait": 300},
    {"key": "Alt+S"},
    {"wait": 300},
    {"click_on": {"button": "tab:item"}},
    {"wait": 200},
    {"expect": {"state": {"windows": ["Inventory", "Skills"]}}},
    {"key": "Escape"},
    {"wait": 200},
    {"expect": {"windows_closed": ["Inventory"], "windows_open": ["Skills"], "state": {"windows": ["Skills"]}}},
    {"key": "Escape"},
    {"wait": 200},
    {"expect": {"windows_closed": ["Skills"], "state": {"windows": [], "escape": null}}},
    {"key": "Escape"},
    {"wait": 300},
    {"expect": {"state": {"escape": ["char_select", "settings", "shortcuts", "exit", "return"]}}},
    {"move": [1000, 750]},
    {"shot": "menu-alive", "crop": [370, 470, 300, 170]},
    {"click_on": {"button": "return"}},
    {"wait": 200},
    {"expect": {"state": {"escape": null}}},
    {"say": "@die"},
    {"wait": 800},
    {"expect": {"state": {"escape": ["save_point", "return"]}, "hp_at_least": 0}},
    {"move": [1000, 750]},
    {"shot": "menu-dead", "crop": [370, 470, 300, 120]},
    {"click_on": {"button": "save_point"}},
    {"wait": 200},
    {"expect": {"state": {"save_asked": true}}},
    {"key": "Escape"},
    {"wait": 200},
    {"expect": {"state": {"save_asked": false, "escape": ["save_point", "return"]}}},
    {"say": "@item 7621 1"},
    {"wait_for": {"event": "PickedUp", "ms": 5000}},
    {"wait": 300},
    {"expect": {"state": {"escape": ["resurrect", "save_point", "return"]}}},
    {"move": [1000, 750]},
    {"shot": "menu-dead-token", "crop": [370, 470, 300, 150]},
    {"say": "@alive"},
    {"wait": 500},
    {"expect": {"state": {"escape": null}, "hp_at_least": 1}},
    {"key": "Escape"},
    {"wait": 200},
    {"expect": {"state": {"escape": ["char_select", "settings", "shortcuts", "exit", "return"]}}},
    {"click_on": {"button": "return"}},
    {"wait": 200}
  ]
}
