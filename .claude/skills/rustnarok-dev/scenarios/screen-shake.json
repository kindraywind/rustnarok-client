{
  "about": "Screen shake (issue #524): @effect 563 (EF_SCREEN_QUAKE) restarts 20 times over 2.2 s and @effect 666 (EF_NPC_EARTHQUAKE) shakes 3 times over 1.8 s, then the camera snaps straight back. /effect off leaves the shake on; /quake turns it off and on.",
  "account": "",
  "slot": 0,
  "env": {"RUSTNAROK_CLIENT_SETTINGS": "{fresh}"},
  "steps": [
    {"say": "@warp prontera 156 180"},
    {"settle": 1500},
    {"move": [1000, 700]},
    {"expect": {"state": {"camera.shaking": false, "camera.yaw": 0, "camera.pitch": 45, "camera.distance": 300}}},
    {"shot": "shake-calm", "threshold": 20},
    {"say": "@effect 563"},
    {"wait": 1500},
    {"expect": {"state": {"camera.shaking": true}}},
    {"shot": "shake-563", "threshold": 25},
    {"wait": 900},
    {"expect": {"state": {"camera.shaking": false, "camera.yaw": 0, "camera.pitch": 45, "camera.distance": 300}}},
    {"say": "@effect 666"},
    {"wait": 1300},
    {"expect": {"state": {"camera.shaking": true}}},
    {"shot": "shake-666", "threshold": 25},
    {"wait": 700},
    {"expect": {"state": {"camera.shaking": false}}},
    {"type": "/effect"},
    {"key": "Enter"},
    {"wait": 300},
    {"say": "@effect 563"},
    {"wait": 300},
    {"expect": {"state": {"camera.shaking": true}}},
    {"type": "/quake"},
    {"key": "Enter"},
    {"wait": 300},
    {"expect": {"chat": "Screen shake OFF", "state": {"camera.shaking": false}}},
    {"shot": "shake-off", "threshold": 20},
    {"type": "/quake"},
    {"key": "Enter"},
    {"wait": 300},
    {"expect": {"chat": "Screen shake ON", "state": {"camera.shaking": true}}},
    {"type": "/effect"},
    {"key": "Enter"},
    {"wait": 2000},
    {"expect": {"state": {"camera.shaking": false}}}
  ]
}
