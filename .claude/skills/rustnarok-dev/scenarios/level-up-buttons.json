    {
      "move": [
        8,
        749
      ]
    },
    {
      "mouse_up": {
        "point": [
          8,
          749
        ]
      }
    },
    {
      "wait": 200
    },
    {
      "expect": {
        "state": {
          "chat_corner": [
            0,
            768
          ]
        }
      }
