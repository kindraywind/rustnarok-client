      ]
    },
    {
      "mouse_up": {
        "point": [
          300,
          400
        ]
      }
    },
    {
      "wait": 200
    },
    {
      "click_on": {
        "button": "level_up_job"
      }
    },
    {
      "wait": 400
    },
    {
      "expect": {
        "windows_open": [
          "Skills"
