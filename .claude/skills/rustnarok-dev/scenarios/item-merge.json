{
  "about": "Item merge (issues #100, #1380): an NPC of our own (npc/merge.txt, loaded with @loadnpc) runs `mergeitem`. With nothing to merge it says so; with two stacks each of HD Elunium Box(5) (16395, 2 and 3) and HD Oridecon Box(5) (16393), items rathena never stacks, the window is a 5 x 3 grid of cells holding the four stacks in the server's order, each with its amount and a check box. One checked isn't enough; an Oridecon can't join a checked Elunium; Ctrl + press checks both Oridecon stacks and clears the Elunium, and again clears them. The second Elunium stack checked first, then the first: OK merges them into the first-listed stack, which keeps 5, and the answer closes the window. Cancel closes it. The NPC lives only in the map server's memory, and the scenario unloads it at both ends.",
  "account": "",
  "slot": 0,
  "steps": [
    {"say": "@warp prontera 156 180"}, {"settle": 1500},
    {"say": "@itemreset"}, {"wait": 800},
    {"say": "@unloadnpcfile {repo}/.claude/skills/rustnarok-dev/npc/merge.txt"}, {"wait": 500},
    {"say": "@loadnpc {repo}/.claude/skills/rustnarok-dev/npc/merge.txt"}, {"wait": 1000},
    {"click_unit": {"kind": "npc", "name": "Merge Test"}}, {"wait_for": {"packet": "0x0291", "ms": 8000}}, {"wait": 300},
    {"expect": {"chat": "Merge items available does not exist.", "windows_closed": ["ItemMerge"]}},
    {"say": "@item 16395 2"}, {"wait_for": {"event": "PickedUp", "ms": 5000}},
    {"say": "@item 16395 3"}, {"wait_for": {"event": "PickedUp", "ms": 5000}},
    {"say": "@item 16393 1"}, {"wait_for": {"event": "PickedUp", "ms": 5000}},
    {"say": "@item 16393 1"}, {"wait_for": {"event": "PickedUp", "ms": 5000}},
    {"wait": 600},
    {"click_unit": {"kind": "npc", "name": "Merge Test"}}, {"wait_for": {"packet": "0x096d", "ms": 8000}}, {"wait": 300},
    {"expect": {"windows_open": ["ItemMerge"], "state": {"merge.rows": 4, "merge.listed": [2, 3, 4, 5], "merge.grid": [5, 3], "merge.position": [512, 384]}}},
    {"move": [1000, 750]},
    {"shot": "merge-open", "crop": [362, 255, 350, 290]},
    {"click_on": {"pick_item": 16395}}, {"wait": 200},
    {"click_on": {"button": "ok"}}, {"wait": 200},
    {"expect": {"chat": "Two or more of the same type.", "windows_open": ["ItemMerge"], "state": {"merge.picked": [2]}}},
    {"click_on": {"pick_item": 16393}}, {"wait": 200},
    {"expect": {"chat": "Combining items will be only one kind at a time.", "state": {"merge.picked": [2]}}},
    {"click_on": {"button": "merge_box_2"}, "mods": "Ctrl"}, {"wait": 200},
    {"expect": {"state": {"merge.picked": [4, 5]}}},
    {"click_on": {"button": "merge_box_3"}, "mods": "Ctrl"}, {"wait": 200},
    {"expect": {"state": {"merge.picked": []}}},
    {"click_on": {"button": "merge_box_1"}}, {"wait": 200},
    {"click_on": {"button": "merge_box_0"}}, {"wait": 200},
    {"expect": {"state": {"merge.picked": [2, 3]}}},
    {"move": [1000, 750]},
    {"shot": "merge-picked", "crop": [362, 255, 350, 290]},
    {"click_on": {"button": "ok"}}, {"wait_for": {"packet": "0x096f", "ms": 5000}}, {"wait": 300},
    {"expect": {"chat": "Item merge is successful.", "windows_closed": ["ItemMerge"], "inventory_has": [{"id": 16395, "amount": 5, "index": 2}, {"id": 16393, "amount": 1}]}},
    {"click_unit": {"kind": "npc", "name": "Merge Test"}}, {"wait_for": {"packet": "0x096d", "ms": 8000}}, {"wait": 300},
    {"expect": {"windows_open": ["ItemMerge"], "state": {"merge.rows": 2}}},
    {"click_on": {"button": "cancel"}}, {"wait": 300},
    {"expect": {"windows_closed": ["ItemMerge"]}},
    {"say": "@itemreset"}, {"wait": 800},
    {"say": "@unloadnpcfile {repo}/.claude/skills/rustnarok-dev/npc/merge.txt"}, {"wait": 500}
  ]
}
