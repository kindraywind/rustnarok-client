{
  "about": "Item merge (issue #100): an NPC of our own (npc/merge.txt, loaded with @loadnpc) runs `mergeitem`. With nothing to merge it says so; with two stacks each of HD Elunium Box(5) (16395) and HD Oridecon Box(5) (16393), items rathena never stacks, the window lists four rows. One pick isn't enough, an Oridecon can't join an Elunium, and two Elunium stacks merge into one of 5. Cancel closes the window. The NPC lives only in the map server's memory, and the scenario unloads it at both ends.",
  "account": "",
  "slot": 0,
  "steps": [
    {"say": "@warp prontera 156 180"}, {"settle": 1500},
    {"say": "@itemreset"}, {"wait": 800},
    {"say": "@unloadnpcfile {repo}/.claude/skills/rustnarok-dev/npc/merge.txt"}, {"wait": 500},
    {"say": "@loadnpc {repo}/.claude/skills/rustnarok-dev/npc/merge.txt"}, {"wait": 1000},
    {"click_unit": {"kind": "npc", "name": "Merge Test"}}, {"wait_for": {"packet": "0x0291", "ms": 8000}}, {"wait": 300},
    {"expect": {"chat": "Merge items available does not exist.", "windows_closed": ["ItemMerge"]}},
    {"say": "@item 16395 2"}, {"wait_for": {"event": "PickedUp", "ms": 5000}},
    {"say": "@item 16395 3"}, {"wait_for": {"event": "PickedUp", "ms": 5000}},
    {"say": "@item 16393 1"}, {"wait_for": {"event": "PickedUp", "ms": 5000}},
    {"say": "@item 16393 1"}, {"wait_for": {"event": "PickedUp", "ms": 5000}},
    {"wait": 600},
    {"click_unit": {"kind": "npc", "name": "Merge Test"}}, {"wait_for": {"packet": "0x096d", "ms": 8000}}, {"wait": 300},
    {"expect": {"windows_open": ["ItemMerge"], "state": {"merge.rows": 4}}},
    {"move": [1000, 750]},
    {"shot": "merge-open", "crop": [362, 260, 300, 270]},
    {"click_on": {"pick_item": 16395}}, {"wait": 200},
    {"click_on": {"button": "ok"}}, {"wait": 200},
    {"expect": {"chat": "Two or more of the same type."}},
    {"click_on": {"pick_item": 16393}}, {"wait": 200},
    {"expect": {"chat": "Combining items will be only one kind at a time."}},
    {"click_on": {"pick_item": 16395, "offset": [0, 32]}}, {"wait": 200},
    {"move": [1000, 750]},
    {"shot": "merge-picked", "crop": [362, 260, 300, 270]},
    {"click_on": {"button": "ok"}}, {"wait_for": {"packet": "0x096f", "ms": 5000}}, {"wait": 300},
    {"expect": {"chat": "Item merge is successful.", "windows_closed": ["ItemMerge"], "inventory_has": [{"id": 16395, "amount": 5}, {"id": 16393, "amount": 1}]}},
    {"click_unit": {"kind": "npc", "name": "Merge Test"}}, {"wait_for": {"packet": "0x096d", "ms": 8000}}, {"wait": 300},
    {"expect": {"windows_open": ["ItemMerge"], "state": {"merge.rows": 2}}},
    {"click_on": {"button": "cancel"}}, {"wait": 300},
    {"expect": {"windows_closed": ["ItemMerge"]}},
    {"say": "@itemreset"}, {"wait": 800},
    {"say": "@unloadnpcfile {repo}/.claude/skills/rustnarok-dev/npc/merge.txt"}, {"wait": 500}
  ]
